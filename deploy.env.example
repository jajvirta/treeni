# Copy this file to `deploy.env` (gitignored) and fill in your values.
# Then run:
#   aws-vault exec <profile> -- ./bootstrap.sh        # one-time static-site infra
#   aws-vault exec <profile> -- ./infra/backend.sh    # one-time backend (DynamoDB + Lambda + API)
#   aws-vault exec <profile> -- ./deploy.sh           # every frontend deploy

# S3 bucket that holds the static files (created by bootstrap.sh).
BUCKET=your-treeni-bucket-name

# Region the bucket lives in.
REGION=eu-north-1

# The EXISTING CloudFront distribution to attach the origin/behavior to.
DISTRIBUTION_ID=E1234567890ABC

# How the app is served by the distribution:
#   empty       -> the app becomes the distribution's DEFAULT behavior (served at /)
#   /treeni/*   -> the app is served under a path prefix (coexists with other content)
PATH_PATTERN=/treeni/*

# ---------------------------------------------------------------------------
# Workout backend (infra/backend.sh). REQUIRED — all workouts are stored in
# DynamoDB. Same design as the reference app: public API Gateway HTTP API in
# front of the Lambda, gated by X-Origin-Secret (CloudFront) + X-Api-Key (you).
# ---------------------------------------------------------------------------

# Secret you paste into the app once (Program tab); sent in the X-Api-Key header.
# Treat it like a password. Generate one with:  openssl rand -hex 24
API_TOKEN=

# Secret CloudFront injects as X-Origin-Secret. REQUIRED: the API endpoint is
# public, so this header (checked by the Lambda) stops direct calls that bypass
# CloudFront. Generate:  openssl rand -hex 24
ORIGIN_SECRET=

# Resource names (defaults are fine; override only to avoid collisions).
TABLE_NAME=treeni
LAMBDA_NAME=treeni-api
API_NAME=treeni-api-http
LAMBDA_ROLE=treeni-api-role
